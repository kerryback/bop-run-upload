__pycache__/
*.py[cod]
*$py.class

# Secrets
.env

koyeb.exe

# Pickle files
*.pkl
*.pickle
pickle.txt

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Output directories (uncomment if these should be ignored)
# outputs/
# figures/
# tables/

# Jupyter Notebook
.ipynb_checkpoints

# pytest
.pytest_cache/

# mypy
.mypy_cache/
.claude/
/debugging
/logs
/outslurm

# Claude working files -- durable across tmp cleanup, never committed
_scratch/
# oracle-only re-runs staged on the cluster (SEED_STAGE=oracle + BOP_RESULTS_DIR);
# never adopted into variants/results until the reproduction check has been read
_evalwin/

# variants/: large reproducible binaries stay out of git (see variants/README.md)
variants/gs_bx/sol_*/
variants/results/*.parquet
variants/results/*_moments_*.npz
variants/results/logs/
variants/results/log_*.txt

# local reference copies, never committed
Code_light/
gap_experiments/

# variants/: solve manifests ARE tracked (a few KB each, and they outlive the
# artifacts they describe). Large artifacts are not -- see variants/README.md.
!experiments/registry/*.json

# per-type G solve checkpoints (local resume state; the manifest is the durable record)
*.solveid

# single-builder lock (runtime state)
.build_vy_tables.*.lock
