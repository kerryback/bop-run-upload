+# =============================================================================
+# term4: sum over live PROJECT PAIRS of exp(b_s . b_s'), aggregated to firms
+#
+#     term4[i, j] = sum_{s in live(i)} sum_{s' in live(j)} exp( b_s . b_s' )
+#
+# where b_s is project s's loading vector on the aggregate shocks, so b_s . b_s' is
+# cov(log C_s, log C_s'). This replaces
+#     r = kron(col2, col2); r.data = np.exp(r.data); r.sum(axis=0).reshape(N, N)
+# which materialises nnz^2 sparse entries to produce an N x N result.
+#
+# term4 is the ONLY term that needs a genuine project-pair double sum: exp() is applied
+# entrywise BEFORE the sum, so it does not factor into column sums the way terms 3, 5, 7
+# and 8 do (see the comment at the term3 site).
+#
+# Verified in voc_diagnosis/refactor_checks/:
+#   - identical to the kron path to 1.4e-16..3.9e-16 relative on real BGN slices (check_b, B4)
+#   - identical to an independent brute-force triple loop at K = 1, 3, 7 (check_a, A3)
+#   - 1.29x faster than kron at K = 1 and ~41x faster at K = 40 (check_e)
+# The sparse aggregator matters: a DENSE S costs O(M^2 N) and is SLOWER than kron.
+# =============================================================================
+def _term4_gram(col2, N, extra=None):
+    """
+    Args:
+        col2:  sparse (S, N) matrix of the price-of-risk-direction loading, nonzero
+               exactly on live project slots.
+        N:     number of firms.
+        extra: optional dense (S, N, K-1) array of additional aggregate-shock loadings.
+               None => K = 1, which reproduces the published one-shock model exactly.
+
+    Returns:
+        (N, N) ndarray.
+    """
+    c = col2.tocoo()
+    M = c.nnz
+    if extra is None:
+        B = c.data.reshape(M, 1)
+    else:
+        B = np.empty((M, 1 + extra.shape[2]), dtype=np.float64)
+        B[:, 0] = c.data
+        B[:, 1:] = extra[c.row, c.col, :]
+
+    E = np.exp(B @ B.T)                       # (M, M); K enters only this GEMM
+    S = csr_matrix((np.ones(M), (np.arange(M), c.col)), shape=(M, N))
+    return np.asarray(S.T @ np.asarray(S.T @ E).T)
+
